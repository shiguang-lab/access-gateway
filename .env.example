GATEWAY_ADDR=:8080
AUTH_SERVICE_URL=http://auth-service:8081
AUTH_SERVICE_TOKEN_FILE=/run/secrets/auth_service_token
IDENTITY_HEADER_SIGNING_SECRET_FILE=/run/secrets/huiguang_identity_header_secret
SESSION_COOKIE_NAME=__Secure-sg_session
ROUTES_FILE=/etc/access-gateway/routes.json
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
GATEWAY_HEALTHCHECK_URL=http://127.0.0.1:8080/health/ready
